# 数据库连接
# 格式: postgresql://用户名:密码@localhost:5432/数据库名?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autosign?schema=public"

# NextAuth 配置
NEXTAUTH_URL="http://localhost:3000"
# 生成密钥: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# 数据加密密钥（用于加密 Cookie/Stoken）
# 生成密钥: openssl rand -hex 16
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# 认证信任主机
AUTH_TRUST_HOST=true

# ==================== 登录方式开关 ====================
# 控制两种登录方式是否可用：
#   - AUTH_OAUTH_ENABLED:   通行证（OAuth/OIDC）登录
#      默认关闭，需显式设为 true 才启用；不填/设为 false 则关闭。
#   - AUTH_PASSWORD_ENABLED: 账号密码登录
#      默认开启，不填即启用；只有显式设为 false 才关闭。
# 注意：不允许两者同时关闭。若都关闭，将兜底启用账号密码登录。
# 示例：默认（只启用账号密码）→ 不填这两个变量即可。
#AUTH_OAUTH_ENABLED=true
#AUTH_PASSWORD_ENABLED=true

# ==================== 通行证（OAuth2/OIDC）登录 ====================
# 授权服务器三个端点 + 客户端凭据
PASSPORT_AUTH_URL="https://passport.example.com/oauth/authorize"
PASSPORT_TOKEN_URL="https://passport.example.com/oauth/token"
PASSPORT_USERINFO_URL="https://passport.example.com/oauth/userinfo"
# OAuth 服务器的 issuer（用于校验 id_token 的 iss 声明，需与服务器实际返回一致）
PASSPORT_ISSUER="https://passport.example.com"
PASSPORT_CLIENT_ID="your-client-id"
PASSPORT_CLIENT_SECRET="your-client-secret"
# 授权 scope，默认 openid profile email
PASSPORT_SCOPE="openid profile email"
# 通行证回调地址（需在授权服务器白名单中配置）：
#   https://你的域名/api/auth/callback/passport





# ============================ 以下为可选配置 ============================


# SMTP 邮件服务配置（用于发送验证码）
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AutoSignin <noreply@example.com>"

# 是否在开发环境也启用分析（设为 true 则 dev 下也会上报，默认为关闭，不填也是关闭）
# NEXT_PUBLIC_ANALYTICS_ENABLE_IN_DEV=false

# ==================== 网站分析（不填则不开启） ====================

# Umami Analytics — 自托管或云端实例
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-umami-website-id"
# NEXT_PUBLIC_UMAMI_URL="https://cloud.umami.is"

# Microsoft Clarity — 用户行为录屏
# NEXT_PUBLIC_CLARITY_ID="your-clarity-project-id"

# Google Analytics (GA4)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"